{
  "description": "Theorem Context lifecycle hooks for Claude Code. Out-of-band orchestration before each model turn; action recording after each tool use; run finalization at session end. Mirrors the schema of codex-hooks.json but uses Claude Code's ${CLAUDE_PLUGIN_ROOT} env var and shell:bash invocation style.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|resume|compact|fork",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hook-doctor.sh SessionStart",
            "timeout": 5,
            "statusMessage": "Recording hook receipt"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/begin-run.sh",
            "timeout": 15,
            "statusMessage": "Starting theorem harness run"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/ambient-health-hook.sh",
            "timeout": 5,
            "statusMessage": "Checking ambient harness delivery"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/sessionstart-codebase.sh",
            "timeout": 15,
            "statusMessage": "Loading codebase context"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/lint-sessionstart.sh",
            "timeout": 55,
            "statusMessage": "Capturing RustyRed lint baseline"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/inject-harness-directives.sh",
            "timeout": 5,
            "statusMessage": "Injecting harness directives"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/sessionstart-writing-engineering.sh",
            "timeout": 5,
            "statusMessage": "Arming writing engineering mode"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hook-doctor.sh UserPromptSubmit",
            "timeout": 5,
            "statusMessage": "Recording hook receipt"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/prepare-context.sh",
            "timeout": 30,
            "statusMessage": "Preparing theorem context"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/ambient-health-hook.sh",
            "timeout": 5,
            "statusMessage": "Checking ambient harness delivery"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/code-neighborhood.sh",
            "timeout": 30,
            "statusMessage": "Composing code neighborhood"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/inject-harness-directives.sh",
            "timeout": 5,
            "statusMessage": "Injecting harness directives"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/checklist-contract.sh",
            "timeout": 10,
            "statusMessage": "Emitting harness checklist"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/subagent-suggest.sh",
            "timeout": 10,
            "statusMessage": "Suggesting subagents"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hook-doctor.sh PreToolUse",
            "timeout": 5,
            "statusMessage": "Recording hook receipt"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_theorems[-_]harness_.*|mcp__theorems[-_]harness(__|[._]).*|mcp__codex_apps__theorems[-_]harness(__|[._]).*",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/auto-approve-harness.sh",
            "timeout": 5,
            "statusMessage": "Authorizing harness tool"
          }
        ]
      },
      {
        "matcher": "Bash|exec_command|functions.exec_command|apply_patch|functions.apply_patch|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/enforce-action-rail.sh",
            "timeout": 5,
            "statusMessage": "Checking theorem action rail"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/pretool-context.sh",
            "timeout": 5,
            "statusMessage": "Capturing pre-tool context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hook-doctor.sh PostToolUse",
            "timeout": 5,
            "statusMessage": "Recording hook receipt"
          }
        ]
      },
      {
        "matcher": "Bash|exec_command|functions.exec_command|apply_patch|functions.apply_patch|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/record-action.sh",
            "timeout": 10,
            "statusMessage": "Recording theorem action"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/posttool-context.sh",
            "timeout": 10,
            "statusMessage": "Recording post-tool context"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/posttool-event.sh",
            "timeout": 10,
            "statusMessage": "Recording coordination event"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/delta-queue.sh",
            "timeout": 5,
            "statusMessage": "Queueing code-delta paths"
          }
        ]
      },
      {
        "matcher": "Bash|exec_command|functions.exec_command|apply_patch|functions.apply_patch|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/lint-posttool.sh",
            "timeout": 35,
            "statusMessage": "Linting touched files"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/filechange-context.sh",
            "timeout": 5,
            "statusMessage": "Capturing file-change context"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/filechange-reingest.sh",
            "timeout": 5,
            "statusMessage": "Reingesting changed files"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/delta-queue.sh",
            "timeout": 5,
            "statusMessage": "Queueing code-delta paths"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hook-doctor.sh Stop",
            "timeout": 5,
            "statusMessage": "Recording hook receipt"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/lint-stop-gate.sh",
            "timeout": 50,
            "statusMessage": "Checking introduced lint diagnostics"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/checklist-gate.sh",
            "timeout": 10,
            "statusMessage": "Checking harness checklist"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/repo-hygiene-receipt.sh",
            "timeout": 25,
            "statusMessage": "Reviewing repository hygiene"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/review-checks.sh",
            "timeout": 60,
            "statusMessage": "Running changed-language review checks"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/stop-style-receipt.sh",
            "timeout": 10,
            "statusMessage": "Recording writing style receipt"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/stop-design-receipt.sh",
            "timeout": 15,
            "statusMessage": "Recording design engineering receipt"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/sessionend-context.sh",
            "timeout": 10,
            "statusMessage": "Flushing session-end context"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/finalize-run.sh",
            "timeout": 30,
            "statusMessage": "Finalizing theorem run"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/code-use-receipt.sh",
            "timeout": 15,
            "statusMessage": "Recording code-use receipts"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/precompact-flush.sh",
            "timeout": 10,
            "statusMessage": "Flushing context before compaction"
          }
        ]
      }
    ]
  }
}
